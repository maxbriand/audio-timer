<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maxbriand.audio-receiver</string>

  <!-- Runs via /bin/zsh for the same reason audio-server-sync does: zsh already holds the
       Full Disk Access grant that lets a background agent write under ~/Documents. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"; set -a; source "$HOME/Library/Application Support/audio-timer/env"; set +a; export AUDIO_TIMER_HOST=127.0.0.1 AUDIO_TIMER_PORT=8787 AUDIO_TIMER_DIR="$HOME/Documents/Assets/Body/sources/audio-sessions"; exec python3 -u "$HOME/Projects/audio-timer/tools/log-receiver.py"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/Users/maximebriand/Library/Logs/audio-receiver.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/maximebriand/Library/Logs/audio-receiver.log</string>
</dict>
</plist>
