<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. launchd does not expand ~, so install it with the home path substituted in:

    sed "s|__HOME__|$HOME|g" \
      ~/Projects/audio-timer/mac/com.maxbriand.body-data-sync.plist \
      > ~/Library/LaunchAgents/com.maxbriand.body-data-sync.plist

  See SETUP.md for the full sequence.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maxbriand.body-data-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/Projects/audio-timer/mac/body-data-sync.sh</string>
  </array>

  <!-- Every 30 minutes. If the Mac was asleep at the due moment, launchd runs it on wake. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- The script keeps its own log; these two only catch anything it fails to swallow. -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/body-data-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/body-data-sync.err.log</string>

  <!-- A background pull must never take priority over what the machine is actually doing. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
