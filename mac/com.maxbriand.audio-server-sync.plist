<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. launchd does not expand ~, so install it with the home path substituted in:

    sed "s|__HOME__|$HOME|g" \
      ~/Projects/audio-timer/mac/com.maxbriand.audio-server-sync.plist \
      > ~/Library/LaunchAgents/com.maxbriand.audio-server-sync.plist

  See SETUP.md for the full sequence.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maxbriand.audio-server-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/Projects/audio-timer/mac/audio-server-sync.sh</string>
  </array>

  <!-- Daily at 16:00. If the Mac was asleep at that moment, launchd runs the missed job on
       wake. If it was powered off entirely, RunAtLoad fires at the next login and the
       script's own guard decides whether a 16:00 run is still owed — so a boot at 09:00
       does not pull early, and a boot at 19:00 catches up the missed one. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>16</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- The script keeps its own log; these two only catch anything it fails to swallow. -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/audio-server-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/audio-server-sync.err.log</string>

  <!-- A background pull must never take priority over what the machine is actually doing. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
