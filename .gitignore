.DS_Store

# Capacitor / Android build inputs and outputs — all regenerated by `npm run apk`
# (run in apps/phone/).
node_modules/
apps/phone/www/
apps/phone/assets/
apps/phone/android/build/
apps/phone/android/app/build/
apps/phone/android/.gradle/
apps/phone/android/local.properties
apps/phone/android/app/src/main/assets/public/
apps/phone/android/app/src/main/assets/capacitor.config.json

# Release signing. Keep these two — an APK upgrade must be signed by the same key — but
# never commit them.
apps/phone/android/*.keystore
apps/phone/android/keystore.properties
