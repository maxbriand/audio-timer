# Capacitor / Android build inputs and outputs — all regenerated by `npm run apk`.
node_modules/
www/
assets/
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json

# Release signing. Keep these two — an APK upgrade must be signed by the same key — but
# never commit them.
android/*.keystore
android/keystore.properties
